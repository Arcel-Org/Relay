{
  "name": "arcel-relay",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bash dev-server.sh",
    "dev:next": "scripts/quiet-deprecation.sh next dev",
    "dev:relay": "ts-node --project tsconfig.server.json server/relay-node.ts",
    "build": "scripts/quiet-deprecation.sh next build",
    "build:relay": "tsc --project tsconfig.server.json --noEmit false --outDir dist-server",
    "start": "scripts/quiet-deprecation.sh next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:e2e": "NEXT_PUBLIC_RELAY_URL=wss://localhost:3020 scripts/quiet-deprecation.sh next build && npm run build:relay",
    "test:e2e": "playwright test",
    "relay": "ts-node --project tsconfig.server.json server/relay-node.ts",
    "analyze": "ANALYZE=true npm run build",
    "load-test:relay": "ts-node --project tsconfig.server.json scripts/load-test-relay.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@noble/ciphers": "2.2.0",
    "@noble/curves": "2.2.0",
    "@noble/hashes": "2.2.0",
    "@noble/post-quantum": "0.6.1",
    "@sentry/node": "^10.67.0",
    "@simplewebauthn/browser": "13.3.0",
    "@simplewebauthn/server": "13.3.2",
    "bip39": "3.1.0",
    "clsx": "^2.0.0",
    "dotenv": "^17.4.2",
    "framer-motion": "^12.42.2",
    "idb-keyval": "^6.2.1",
    "lucide-react": "^1.23.0",
    "next": "^16.4.0",
    "otpauth": "9.5.1",
    "pako": "^3.0.1",
    "postcss": "^8.5.15",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "unicode-emoji-json": "^0.9.0",
    "uuid": "^14.0.1",
    "ws": "^8.19.0",
    "zod": "4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.3",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.0.0",
    "@types/pako": "^2.0.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/uuid": "^9.0.0",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.2.10",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^24.1.3",
    "ts-node": "^10.9.2",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "vite": "^7.3.6",
    "esbuild": "^0.28.1",
    "next": {
      "postcss": "^8.5.15",
      "sharp": "^0.35.3"
    }
  }
}

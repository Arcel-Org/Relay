# Environment variables for Arcel Relay
# This file is for local development only
# Never commit real secrets to version control
#
# The recommended way to create a production .env is `./scripts/setup.sh`,
# which generates the secrets below with openssl and asks you for
# RELAY_PUBLIC_URL (then derives NEXT_PUBLIC_RELAY_URL, WS_ALLOWED_ORIGINS and
# WEBAUTHN_* from it automatically). Everything in this file is also fine to
# set by hand.

# The canonical public URL the app is served at, e.g. https://relay.example.com.
# Used by scripts/setup.sh to derive the relay WebSocket URL, the allowed
# origins, and the WebAuthn values below. (The app itself reads the derived
# vars, not this one.)
# RELAY_PUBLIC_URL=https://relay.example.com

# Relay Server Configuration
# In Docker deployments this is baked into the client bundle at BUILD time
# (Next.js inlines every NEXT_PUBLIC_* var via static substitution — it is
# never read at runtime in the browser), so it must be the real PUBLIC
# wss:// URL a browser can actually reach (through your reverse proxy —
# see docs/DEPLOY.md §13), never an internal Docker service name like
# `relay:8080`. Changing this value requires rebuilding the image
# (`docker compose build`), not just restarting the container.
NEXT_PUBLIC_RELAY_URL=ws://localhost:8080
# RELAY_PORT=8080
# MESSAGE_TTL_MINUTES=20
# MAX_WS_CONNECTIONS=10000
# RELAY_DEBUG_LOGS=false

# Optional opt-in encrypted cloud backup ("Vault"). Off by default and has
# NO fallback URL — if you enable this feature in Settings without setting
# this, it fails closed rather than silently syncing anywhere. If you're
# self-hosting, point this at your OWN vault backend, not a third party's —
# see lib/vault/relay-vault.ts.
# NEXT_PUBLIC_VAULT_URL=https://your-own-vault-backend.example.com

# Comma-separated list of origins allowed to open a WebSocket connection to
# the relay (checked against the browser's Origin header). MUST be set
# outside development/test — the relay refuses to start without it, to
# prevent any other site from opening cross-origin WebSocket connections to
# your relay. Example: WS_ALLOWED_ORIGINS=https://relay.arcel.org
# WS_ALLOWED_ORIGINS=https://relay.arcel.org

# TURN server for media relay (optional but recommended for voice/video calls)
# Without this, calls fall back to public STUN + direct peer-to-peer —
# functional, but the two callers' real IP addresses are exposed to each
# other via ICE candidates.
#
# To enable: add the coturn compose file (`docker compose -f docker-compose.yml
# -f docker-compose.turn.yml up -d`, which wires this up automatically) and set
# the same secret on both sides:
# TURN_SECRET=replace-with-a-random-secret          # generate: openssl rand -hex 32
# TURN_PUBLIC_HOST=your-server-hostname             # defaults to the request Host header if unset
#
# The app mints a short-lived (6h) per-user credential server-side via
# app/api/turn-credentials — there is no long-lived client-exposed TURN
# credential to leak (a prior static NEXT_PUBLIC_TURN_* pair was removed for
# exactly this reason: anyone who viewed the page source could use it
# indefinitely as an open relay).

# Trust CF-Connecting-IP / X-Real-IP for rate-limit bucketing (lib/rate-limit.ts).
# Only set this once your deployment topology genuinely guarantees the app
# is unreachable except through Cloudflare and/or your own nginx (e.g. the
# app/relay ports are firewalled to loopback/Cloudflare's IP ranges — see
# docs/DEPLOY.md section 7). Left unset, all direct-connection clients share
# one rate-limit bucket, which is conservative but never spoofable.
# TRUST_PROXY_HEADERS=true

# Session signing secret — must be set in production (min 32 characters).
# Used only to sign short-lived WS connection tickets now (15 min); the
# session cookie itself is an opaque random token verified against a
# server-side session store (lib/db/session-store.ts), so a leaked
# SESSION_SECRET alone can no longer forge a login session.
# Generate with: openssl rand -hex 32
# SESSION_SECRET=replace-with-a-random-32-plus-character-secret

# Directory where session records (lib/db/session-store.ts) are persisted.
# Defaults to `<cwd>/.data` (same place as the user store). Override to
# point at an isolated directory, e.g. in tests.
# SESSION_STORE_DIR=./.data

# Directory for the main SQLite database (relay.db — users, groups, abuse
# reports, warrant-canary confirmations/legal-request records) and the
# canary-uploads/ subdirectory holding redacted legal-request PDFs. Defaults
# to `<cwd>/.data`. This is the directory your backup script needs to cover —
# see docs/DEPLOY.md's backup section.
# DATA_DIR=./.data

# Point the database at a remote/embedded-replica primary (e.g. Turso)
# instead of the local embedded file at DATA_DIR — only needed if you're
# scaling beyond a single instance. Leave unset for the default embedded
# single-file mode.
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=replace-with-your-turso-auth-token

# TOTP-at-rest encryption key — must be set in production (exactly 64 hex chars / 32 bytes)
# Encrypts the server-side TOTP secret in users.json so a DB leak alone can't
# forge a login. Generate with: openssl rand -hex 32
# Keep this OUT of the same backup/location as users.json — the whole point
# is that compromising one alone isn't enough.
# TOTP_ENCRYPTION_KEY=replace-with-64-random-hex-characters

# WebAuthn/FIDO2 hardware key support — must be set in production.
# WEBAUTHN_RP_ID is your bare domain (no scheme/port), e.g. "relay.arcel.org".
# WEBAUTHN_ORIGIN must be the exact scheme+host+port users load the app from.
# Both default to localhost/http://localhost:3000 for dev — leaving them at
# the dev default in production silently breaks all hardware-key registration
# and login (WebAuthn is origin-bound by the browser, not just this app).
# WEBAUTHN_RP_ID=relay.arcel.org
# WEBAUTHN_ORIGIN=https://relay.arcel.org

# Opt-in server-side crash reporting via Sentry (or a self-hosted,
# Sentry-protocol-compatible alternative like GlitchTip). Unset by default —
# behavior is unchanged unless you set this. Server-side only, never the
# browser client. See docs/DEPLOY.md's Error Monitoring section.
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Comma-separated Relay ID(s) allowed to reach the abuse-report admin
# dashboard (/app/admin), the warrant-canary admin dashboard
# (/app/admin/canary), and their APIs (/api/admin/*). Fails closed — unset
# means the admin surface is unreachable by anyone, not open to everyone.
# These are the operator's own Relay ID(s) (Settings > your profile > Relay
# ID), not a display name or username.
# ADMIN_RELAY_IDS=xxxx-xxxx-xxxx-xxxx-xxxx-xxxx-xxxx-xxxx

# Cover traffic — the relay sends small dummy frames on a random cadence to
# connected-but-idle clients (dropped client-side before reaching app code)
# so an observer watching encrypted traffic volume/timing alone can't
# distinguish "actively chatting" from "idle but connected". ON by default;
# set to 'false' to disable (e.g. to reduce bandwidth on a constrained
# deployment) — there is otherwise no visible indication this control exists.
# COVER_TRAFFIC_ENABLED=true

# Automatic inactive-account deletion — disabled by default (0/unset). Set
# to enable a daily sweep that deletes accounts inactive longer than this
# many days. NEXT_PUBLIC_MAX_INACTIVE_DAYS is read as a fallback so the same
# value can be surfaced in client-side UI copy if desired; MAX_INACTIVE_DAYS
# takes precedence if both are set.
# MAX_INACTIVE_DAYS=365
